# Release signing: never commit key material
*.jks
*.keystore
*.p12
# Exception: pinned DEBUG keystore (standard android/android credentials,
# not secret) so CI debug APKs share one signature and install as updates.
!app/debug.keystore

# Gradle
.gradle/
build/
app/build/
local.properties
# The wrapper jar is generated via `gradle wrapper` (checked in once generated).
!gradle/wrapper/gradle-wrapper.jar

# Android Studio
.idea/
*.iml

# OS
.DS_Store
