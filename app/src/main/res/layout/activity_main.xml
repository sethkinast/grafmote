<?xml version="1.0" encoding="utf-8"?>
<!-- Round 11 polish: header (LED + selector + gear + power), ONE connected
      plus-shaped D-pad (layer-list cross face + transparent arrow touch
      zones, OK seated in the center, Back at 7 o'clock / Home at 4 o'clock),
      compact rocker row (single-pill VOL / CH backgrounds with transparent
      +/- touch halves, narrow as a D-pad arm), small round utility buttons
      all at ONE diameter (52dp), square app tiles at ONE size (88dp, set in
      code), inset rule instead of an "Apps" header. All depth comes from
      diagonal-gradient shape drawables (light from the top-right, angle=45)
      plus subtle 1dp elevation. No image assets except vectors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: status LED dot + TV selector + gear + power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot"
            android:contentDescription="Connection status" />

        <Spinner
            android:id="@+id/tvSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Setup"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Power"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <!-- D-pad: ONE connected plus. The cross face is a single layer-list
         background; the four arrows are transparent touch zones over its
         arms (zero gap, zero seam) and the round OK button sits in the
         center covering the bar intersection. Back (7 o'clock) and Home
         (4 o'clock) are small round buttons tucked below the cross. This
         section takes all leftover vertical space so the rows sit closer
         together on tall screens instead of leaving a dead band. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="240dp"
            android:layout_height="240dp">

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_dpad_cross"
                android:elevation="1dp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_above="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_below="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_toStartOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="◀"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_toEndOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnOk"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_circle_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="OK"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Back"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↩"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⌂"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom row: narrow volume pill | mute + play/pause | narrow channel
         pill. Each rocker is ONE pill background (68dp wide, as narrow as a
         D-pad arm) with two transparent touch halves — no seam, no divider
         line between the halves. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <!-- LEFT: single connected volume pill -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="168dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- MIDDLE: mute + play/pause, same 52dp diameter as every other
             small round utility button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="168dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Mute"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_mute" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Play/Pause"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⏯"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- RIGHT: single connected channel pill -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="168dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textSize="22sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Inset horizontal rule separating the remote from the app tiles -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:background="#2E2E33" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
