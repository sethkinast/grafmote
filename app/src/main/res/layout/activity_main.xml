<?xml version="1.0" encoding="utf-8"?>
<!-- LG-remote-style layout: header (LED + selector + gear + power), classic
     CROSS (plus-shaped) D-pad with Back/Home tucked below it, three-column
     bottom row (volume rocker / mute+play-pause / channel rocker), square-ish
     app tiles. All depth comes from diagonal-gradient shape drawables (light
     from the top-right, angle=45) plus subtle 1dp elevation. No image assets
     except vectors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: status LED dot + TV selector + gear + power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot"
            android:contentDescription="Connection status" />

        <Spinner
            android:id="@+id/tvSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Setup"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Power"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <!-- D-pad: classic CROSS (plus) cluster. Four rounded-square arrow
         buttons on the axes around the round OK button, Back (7 o'clock) and
         Home (4 o'clock) as small round buttons tucked below the cross. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="280dp"
            android:layout_height="280dp">

            <Button
                android:id="@+id/btnOk"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_circle_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="OK"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_above="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="6dp"
                android:background="@drawable/btn_dpad_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_below="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_dpad_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_toStartOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_dpad_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="◀"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_toEndOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_dpad_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Back"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↩"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⌂"
                android:textSize="22sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom row: volume rocker | mute + play/pause | channel rocker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- LEFT: single connected vertical volume rocker (rounded rectangle) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnVolUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rocker_top_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textSize="26sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#1A1A1C" />

            <Button
                android:id="@+id/btnVolDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rocker_bottom_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- MIDDLE: two smaller round buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Mute"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_mute" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Play/Pause"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⏯"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- RIGHT: single connected vertical channel rocker (rounded rectangle) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnChUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rocker_top_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="24sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#1A1A1C" />

            <Button
                android:id="@+id/btnChDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rocker_bottom_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Apps -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Apps"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
