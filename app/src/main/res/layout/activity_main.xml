<?xml version="1.0" encoding="utf-8"?>
<!-- Round 18 polish: per-segment pressed states (each rocker half darkens
      that end of the pill, each D-pad arrow darkens its arm — darker
      pressed overlays keep the top-right light, angle=45), small round
      glyphs all as square-viewport vectors with scaleType="center" (mute
      was the reference; back/home/play-pause converted from text glyphs),
      doubled D-pad→rocker gap (40dp), everything scaled ~+10% over round 17
      (D-pad 330dp cluster / 275dp cross / 88dp arms / 99dp OK, 72dp round
      utility buttons, 94x231dp rockers, 97dp app tiles set in code).
      Layout structure and IDs unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: ONE unified top bar — raised TV selector pill (LED dot +
         TV name + chevron in a single contained pill) on the left, recessed
         inset icon panel (gear + power baked into a darker well) on the
         right. IDs and view types are unchanged (statusDot View, tvSpinner
         Spinner, btnSettings/btnPower ImageButton) so wiring is untouched. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Raised selector pill: single tappable-looking unit. Selector
             background + addStatesFromChildren so a spinner press darkens
             the whole pill (same darker pressed tint as every other face). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:addStatesFromChildren="true"
            android:background="@drawable/topbar_selector_pill_selector"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_dot"
                android:contentDescription="Connection status" />

            <Spinner
                android:id="@+id/tvSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:clickable="false"
                android:focusable="false"
                android:text="▾"
                android:textColor="#f2f2f2"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Recessed inset icon panel: darker well behind the two icons.
             Square-viewport vectors, scaleType center: glyphs seat centered. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/topbar_inset_panel"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_touch_ripple"
                android:contentDescription="Setup"
                android:scaleType="center"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btnPower"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_touch_ripple"
                android:contentDescription="Power"
                android:scaleType="center"
                android:src="@drawable/ic_power" />
        </LinearLayout>
    </LinearLayout>

    <!-- D-pad: ONE seamless plus. The cross face is a single strokeless
         layer-list background; the four arrows are touch zones over its arms
         (transparent at rest, darker arm overlay + ripple while pressed) and
         the round OK button sits in the center keeping its circular border.
         Back and Home are small round ImageButtons (square-viewport vectors,
         scaleType center) tucked below the cross. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="330dp"
            android:layout_height="330dp">

            <View
                android:layout_width="275dp"
                android:layout_height="275dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_dpad_cross"
                android:elevation="1dp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_above="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_dpad_up_selector"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="31sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_below="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_dpad_down_selector"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="31sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_toStartOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_dpad_left_selector"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="◀"
                android:textSize="31sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_toEndOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_dpad_right_selector"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶"
                android:textSize="31sp" />

            <Button
                android:id="@+id/btnOk"
                android:layout_width="99dp"
                android:layout_height="99dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_circle_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="OK"
                android:textSize="24sp" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Back"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_home" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom row: narrow volume pill | mute + play/pause | narrow channel
         pill. Each rocker is ONE pill background with two touch halves —
         transparent at rest (no seam), darker half overlay + ripple while
         pressed. Doubled 40dp gap above this row separates it from the
         D-pad cluster; the weight-1 spacer below shrinks to compensate so
         the remote section still fits without scrolling. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <!-- LEFT: single connected volume pill -->
        <FrameLayout
            android:layout_width="94dp"
            android:layout_height="231dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rocker_top_selector"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="33sp" />

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rocker_bottom_selector"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="33sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- MIDDLE: mute + play/pause, same 72dp diameter as every other
             small round utility button. Square-viewport vectors with
             scaleType center so glyphs seat dead-center (mute is the ref). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="231dp"
            android:layout_marginStart="31dp"
            android:layout_marginEnd="31dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Mute"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_mute" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="17dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Play/Pause"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_playpause" />
        </LinearLayout>

        <!-- RIGHT: single connected channel pill -->
        <FrameLayout
            android:layout_width="94dp"
            android:layout_height="231dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rocker_top_selector"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textSize="31sp" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rocker_bottom_selector"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textSize="31sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Spacer: any leftover vertical space lives HERE, between the rocker
         row and the app-tiles section — never above the D-pad, so the top
         of the screen (below the top bar) stays full. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Inset horizontal rule separating the remote from the app tiles -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:background="#2E2E33" />

    <!-- App tiles: 1-8 tiles wrap to up to two centered rows of 4
         (partial second row centered); 9+ fall back to today's
         horizontally scrolling single row. The visible container wraps its
         height (one row for <=4, two rows for 5-8). -->
    <HorizontalScrollView
        android:id="@+id/appsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/appsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/appsRowTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:id="@+id/appsRowBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</LinearLayout>
