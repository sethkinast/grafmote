<?xml version="1.0" encoding="utf-8"?>
<!-- Round 14 polish: header (LED + selector + gear + power), ONE seamless
     plus-shaped D-pad (strokeless layer-list cross face + transparent arrow
     touch zones, OK seated in the center with its circular border, Back at
     7 o'clock / Home at 4 o'clock) at pre-round-13 proportions, compact
     rocker row (single-pill VOL / CH backgrounds with transparent +/-
     touch halves), small round utility buttons all at ONE diameter (52dp),
     square app tiles at ONE size (88dp, set in code), inset rule instead of
     an "Apps" header. Leftover vertical space sits between the rocker row
     and the app tiles (spacer view), never above the D-pad. App tiles
     center when they fit, scroll from the left on overflow (fillViewport +
     match_parent/gravity). All depth comes from diagonal-gradient shape
     drawables (light from the top-right, angle=45) plus subtle 1dp
     elevation. No image assets except vectors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: status LED dot + TV selector + gear + power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot"
            android:contentDescription="Connection status" />

        <Spinner
            android:id="@+id/tvSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Setup"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Power"
            android:elevation="1dp"
            android:scaleType="center"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <!-- D-pad: ONE seamless plus at pre-round-13 proportions. The cross face
         is a single strokeless layer-list background (no internal divider
         lines); the four arrows are transparent touch zones over its arms
         (zero gap, zero seam) and the round OK button sits in the center
         keeping its circular border. Back (7 o'clock) and Home (4 o'clock)
         are small round buttons tucked below the cross. wrap_content + top
         margin: the cluster sits just below the top bar so the top of the
         screen feels full; leftover space lives in the spacer below the
         rockers. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="240dp"
            android:layout_height="240dp">

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_dpad_cross"
                android:elevation="1dp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_above="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_below="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_toStartOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="◀"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_toEndOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnOk"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_circle_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="OK"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Back"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↩"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⌂"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom row: narrow volume pill | mute + play/pause | narrow channel
         pill. Each rocker is ONE pill background (68dp wide, as narrow as a
         D-pad arm) with two transparent touch halves — no seam, no divider
         line between the halves. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <!-- LEFT: single connected volume pill -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="168dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- MIDDLE: mute + play/pause, same 52dp diameter as every other
             small round utility button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="168dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Mute"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_mute" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Play/Pause"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⏯"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- RIGHT: single connected channel pill -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="168dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textSize="22sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Spacer: any leftover vertical space lives HERE, between the rocker
         row and the app-tiles section — never above the D-pad, so the top
         of the screen (below the top bar) stays full. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Inset horizontal rule separating the remote from the app tiles -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:background="#2E2E33" />

    <!-- App tiles: centered when they fit, left-scrolling on overflow.
         fillViewport forces the row to at least the viewport width;
         match_parent + center gravity centers a short row, while a wide
         row simply grows past the viewport and scrolls from the left. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
