<?xml version="1.0" encoding="utf-8"?>
<!-- Round 16 polish: unified top bar (raised selector pill on the left +
     recessed inset icon panel on the right), ONE seamless plus-shaped
     D-pad (strokeless layer-list cross face + transparent arrow
     touch zones, OK seated in the center with its circular border, Back at
     7 o'clock / Home at 4 o'clock) scaled ~+25% over rounds 14-15,
     roomier rocker row (single-pill VOL / CH backgrounds with transparent
     +/- touch halves, ~+25%), round utility buttons all at ONE larger
     diameter (65dp), clear vertical gap between the D-pad section and the
     rocker row, square app tiles at ONE size (88dp, set in code), inset
     rule instead of an "Apps" header. Leftover vertical space sits between
     the rocker row and the app tiles (spacer view, shrinks to compensate),
     never above the D-pad. App tiles center when they fit, scroll from the
     left on overflow (fillViewport + match_parent/gravity). All depth comes
     from diagonal-gradient shape drawables (light from the top-right,
     angle=45; the icon well runs the reverse angle for an inset feel) plus
     subtle 1dp elevation on raised faces only. No image assets except
     vectors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: ONE unified top bar — raised TV selector pill (LED dot +
         TV name + chevron in a single contained pill) on the left, recessed
         inset icon panel (gear + power baked into a darker well) on the
         right. IDs and view types are unchanged (statusDot View, tvSpinner
         Spinner, btnSettings/btnPower ImageButton) so wiring is untouched. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Raised selector pill: single tappable-looking unit. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/topbar_selector_pill"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_dot"
                android:contentDescription="Connection status" />

            <Spinner
                android:id="@+id/tvSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:clickable="false"
                android:focusable="false"
                android:text="▾"
                android:textColor="#f2f2f2"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Recessed inset icon panel: darker well behind the two icons. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/topbar_inset_panel"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_touch_ripple"
                android:contentDescription="Setup"
                android:scaleType="center"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btnPower"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_touch_ripple"
                android:contentDescription="Power"
                android:scaleType="center"
                android:src="@drawable/ic_power" />
        </LinearLayout>
    </LinearLayout>

    <!-- D-pad: ONE seamless plus, ~+25% over rounds 14-15. The cross face
         is a single strokeless layer-list background (no internal divider
         lines); the four arrows are transparent touch zones over its arms
         (zero gap, zero seam) and the round OK button sits in the center
         keeping its circular border. Back (7 o'clock) and Home (4 o'clock)
         are small round buttons tucked below the cross. wrap_content + top
         margin: the cluster sits just below the top bar so the top of the
         screen feels full; leftover space lives in the spacer below the
         rockers. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="300dp"
            android:layout_height="300dp">

            <View
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_dpad_cross"
                android:elevation="1dp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_above="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▲"
                android:textSize="28sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_below="@id/btnOk"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▼"
                android:textSize="28sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_toStartOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="◀"
                android:textSize="28sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_toEndOf="@id/btnOk"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_touch_ripple"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="▶"
                android:textSize="28sp" />

            <Button
                android:id="@+id/btnOk"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_circle_selector"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="OK"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Back"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↩"
                android:textSize="25sp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⌂"
                android:textSize="25sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom row: narrow volume pill | mute + play/pause | narrow channel
         pill. Each rocker is ONE pill background (85dp wide, as narrow as a
         D-pad arm) with two transparent touch halves — no seam, no divider
         line between the halves. Clear 20dp gap above this row separates it
         from the D-pad cluster; the weight-1 spacer below shrinks to
         compensate so the remote section still fits without scrolling. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <!-- LEFT: single connected volume pill -->
        <FrameLayout
            android:layout_width="85dp"
            android:layout_height="210dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="30sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- MIDDLE: mute + play/pause, same 65dp diameter as every other
             small round utility button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="210dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Mute"
                android:elevation="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_mute" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/btn_circle_selector"
                android:contentDescription="Play/Pause"
                android:elevation="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⏯"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- RIGHT: single connected channel pill -->
        <FrameLayout
            android:layout_width="85dp"
            android:layout_height="210dp"
            android:background="@drawable/btn_rocker_pill"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textSize="28sp" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_touch_ripple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textSize="28sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Spacer: any leftover vertical space lives HERE, between the rocker
         row and the app-tiles section — never above the D-pad, so the top
         of the screen (below the top bar) stays full. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Inset horizontal rule separating the remote from the app tiles -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:background="#2E2E33" />

    <!-- App tiles: centered when they fit, left-scrolling on overflow.
         fillViewport forces the row to at least the viewport width;
         match_parent + center gravity centers a short row, while a wide
         row simply grows past the viewport and scrolls from the left. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>
</LinearLayout>
