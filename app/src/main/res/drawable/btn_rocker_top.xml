<?xml version="1.0" encoding="utf-8"?>
<!-- Top half of a vertical rocker: modest 12dp rounded top, square bottom
     so it joins the bottom half seamlessly. Same top-right light (angle=45). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#2E2E33"
        android:endColor="#585862" />
    <corners
        android:topLeftRadius="12dp"
        android:topRightRadius="12dp"
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="4dp" />
    <stroke
        android:width="1dp"
        android:color="#1A1A1C" />
</shape>
