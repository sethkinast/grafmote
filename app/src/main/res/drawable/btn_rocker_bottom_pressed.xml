<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed overlay for the BOTTOM half of a rocker pill: same top-right
     light (angle=45), uniformly darker. Strokeless so no seam cuts across
     the middle of the pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#222226"
        android:endColor="#3D3D45" />
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="33dp"
        android:bottomRightRadius="33dp" />
</shape>
