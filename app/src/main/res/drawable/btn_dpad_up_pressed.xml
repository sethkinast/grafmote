<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed overlay for the UP arm of the D-pad cross: same top-right light
     (angle=45), uniformly darker. Top corners match the bar end radius;
     bottom is square so it melts into the cross. Strokeless like the face. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#222226"
        android:endColor="#3D3D45" />
    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
