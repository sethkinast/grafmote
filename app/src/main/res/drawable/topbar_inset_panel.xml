<?xml version="1.0" encoding="utf-8"?>
<!-- Round 15 top-bar inset icon panel: recessed container behind the gear +
     power icons so they look baked into the bar, not floating beside it.
     Darker than the window (#141414) with the gradient running opposite to
     the raised faces (angle=225: darker toward the top-right light) plus a
     near-black edge — fakes an inner-shadow / carved-in feel with a plain
     shape drawable. No elevation in layout (recessed, not raised). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="225"
        android:startColor="#232327"
        android:endColor="#0E0E10" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#08080A" />
</shape>
