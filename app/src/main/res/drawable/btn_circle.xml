<?xml version="1.0" encoding="utf-8"?>
<!-- Circular button face. Diagonal gradient: lighter at top-right, darker at
     bottom-left (single light source from the top-right, angle=45). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="45"
        android:startColor="#2E2E33"
        android:endColor="#585862" />
    <stroke
        android:width="1dp"
        android:color="#1A1A1C" />
</shape>
