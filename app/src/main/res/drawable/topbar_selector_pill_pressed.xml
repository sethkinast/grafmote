<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed state for the top-bar TV selector pill: same top-right light
     direction (angle=45), uniformly darker — matches btn_face_pressed /
     btn_circle_pressed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#222226"
        android:endColor="#3D3D45" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#101012" />
</shape>
