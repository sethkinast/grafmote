<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad arrow face: rounded square (not circular) so the four arrows read
     as a classic plus-shaped cross around the round OK button. Same
     top-right light source as the round buttons (gradient angle=45). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#2E2E33"
        android:endColor="#585862" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#1A1A1C" />
</shape>
