<?xml version="1.0" encoding="utf-8"?>
<!-- Round 15 top-bar selector pill: ONE contained pill for LED + TV name +
     chevron. Same raised depth as every other face — diagonal gradient with
     the shared top-right light (angle=45) plus 1dp elevation in layout —
     so it reads as a single tappable unit, not loose parts. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#2E2E33"
        android:endColor="#585862" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#1A1A1C" />
</shape>
