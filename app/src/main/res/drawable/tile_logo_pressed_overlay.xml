<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed logo tile pressed overlay (round 26): transparent at rest so
     the edge-to-edge logo shows fully; a translucent black with the same
     15dp radius while pressed so the logo visibly darkens like every other
     face (btn_face_selector stays the tile background underneath). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
