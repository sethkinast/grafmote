<?xml version="1.0" encoding="utf-8"?>
<!-- Single continuous rocker pill: ONE rounded-rect background per rocker.
     The VOL / CH halves are transparent touch zones layered on top, so at
     rest there is no seam or gap — one control, two touch zones. Same
     top-right light (angle=45) as every other face. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#2E2E33"
        android:endColor="#585862" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="#1A1A1C" />
</shape>
