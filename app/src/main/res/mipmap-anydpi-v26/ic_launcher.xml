<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Pre-26 devices fall back to the legacy
     mipmap-*/ic_launcher.png set, which is left untouched.
     Foreground artwork keeps important content in the center 72dp safe zone;
     the background full-bleeds to 108dp. The launcher applies its own mask
     (circle/squircle), so no roundIcon is needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
